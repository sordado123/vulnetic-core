# os
.DS_Store
Thumbs.db

# claude code local state
.claude/

# single-binary artifact with embedded frontend
/vulnetic
/artex
# intermediate artifacts left next to the executable by one-click update (staging file / backup / failed version / upgrade marker)
/vulnetic.new
/vulnetic.new.sha256
/vulnetic.old
/vulnetic.failed
/vulnetic.upgrade.json
/artex.new
/artex.new.sha256
/artex.old
/artex.failed
/artex.upgrade.json
/server/webui/dist/
/dist/

# JWT signing key (generated at runtime, stored in the project root, never committed)
/jwt.key

# Vault master key (KEK wrapping each account's DEK, Fase B) — same rationale as jwt.key
/vault.key

# local environment generated by Docker deployment (contains passwords/keys, not committed)
.env
.env.beta

# event logs produced by scheduler runs/simulations (test artifacts, not committed)
*-events.csv

# bench benchmark related (local artifacts, not committed)
/bench/
/Dockerfile.bench
/Dockerfile.bench.v2backups/

# posture probe raw output
posture-runs/

# benchmark runner output (one dir per run)
benchmark-results/

# override local: publica o Postgres no loopback para rodar o binario no host
docker-compose.override.yml
*.bat.local

# local build/run artifacts (binaries, backups, ad-hoc run logs)
*.exe
*.log
start-local.bat
start-local-run.log
*.bat.local

