# Generate two independent values with: python -c "import secrets; print(secrets.token_hex(32))"
# Hex avoids reserved URI characters in the PostgreSQL connection string.
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=
VULNETIC_SIGNUP_ALLOWLIST=
VULNETIC_BETA_PORT=8795
VULNETIC_PUBLIC_URL=
# Restricted connector configuration for docker-compose.protected.yml
VULNETIC_TUNNEL_ID=
VULNETIC_CLOUDFLARED_IMAGE=
VULNETIC_LEGACY_AGENT_UNTIL=
VULNETIC_PROTECTED_TARGETS=
