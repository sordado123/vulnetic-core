# Docker deployment configuration (copy to .env)
VULNETIC_TAG=latest
POSTGRES_USER=vulnetic
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=vulnetic
# Optional: password for the non-owner "vulnetic_app" role (Row-Level Security
# defense-in-depth, RLS-1 — see db/schema.sql §Z2). Leave empty to keep RLS-1
# off, exactly as before it existed; set a real password to opt in.
POSTGRES_APP_PASSWORD=

# LLM (fill one or both; you can also leave empty and configure in the UI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VULNETIC_LLM_PROVIDER=
VULNETIC_LLM_MODEL=
VULNETIC_LLM_BASE_URL=
VULNETIC_LLM_PROXY=
# Shared SaaS restrictions (development; release gates are in docs/saas-beta-status.md).
# Keep disabled until the remaining account-isolation work is complete.
VULNETIC_SAAS_MODE=false
VULNETIC_SIGNUP_ALLOWLIST=
